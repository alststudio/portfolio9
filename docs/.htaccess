# Blendy — konfigurasi Apache opsional (untuk hosting cPanel/shared hosting)
# File ini TIDAK dipakai oleh GitHub Pages (diabaikan dengan aman).

# Halaman 404 bawaan: arahkan ke beranda katalog
ErrorDocument 404 /index.html

# Keamanan dasar: cegah penjelajahan direktori
Options -Indexes

# Jangan tampilkan file sensitif
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Kompresi teks
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache aset statis (1 minggu)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>
